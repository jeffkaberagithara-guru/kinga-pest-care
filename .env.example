# =============================================================================
# KINGA Pest Care — environment configuration
# Copy to `.env.local` and fill in. NEVER commit a filled .env file.
#
# Variables prefixed NEXT_PUBLIC_ are sent to the browser. Only put PUBLIC
# business details here (phone, email, address) — never secrets.
# Variables WITHOUT the prefix are server-only and must stay secret.
# =============================================================================

# --- Site / SEO -------------------------------------------------------------
# The canonical production URL. No trailing slash. Used for metadataBase,
# canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Business identity (public) --------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=KINGA Pest Care
NEXT_PUBLIC_BUSINESS_WORDMARK=KINGA
NEXT_PUBLIC_BUSINESS_DESCRIPTOR=Pest Care
NEXT_PUBLIC_LEGAL_NAME=KINGA Pest Care

# --- Contact details (public). One line serves normal, urgent/emergency and
# inspection calls, plus WhatsApp. phoneDisplay is shown to visitors; phoneHref
# is used in tel: links (E.164, no spaces). whatsapp is the number WITHOUT +
# or spaces (e.g. 2547xxxxxxxx). Override the email before launch.
NEXT_PUBLIC_PHONE_DISPLAY=+254 707 764 281
NEXT_PUBLIC_PHONE_HREF=+254707764281
NEXT_PUBLIC_WHATSAPP=254707764281
NEXT_PUBLIC_EMAIL=hello@your-domain.example

# --- Location & coverage (public) ------------------------------------------
NEXT_PUBLIC_ADDRESS_1=Your office or service base
NEXT_PUBLIC_ADDRESS_2=Nairobi, Kenya
NEXT_PUBLIC_AREA=Nairobi and surrounding areas
NEXT_PUBLIC_SERVICE_AREA=Coverage areas are confirmed when you request an inspection.
NEXT_PUBLIC_HOURS=Mon–Sat, 8:00–18:00

# --- Regulatory (optional, public) -----------------------------------------
# Only set this if the business holds a real, current PCPB registration number.
# Leave empty to publish no registration claim.
NEXT_PUBLIC_PCPB_LICENCE=

# =============================================================================
# Server-only secrets — never expose, never prefix with NEXT_PUBLIC_
# =============================================================================

# Contact delivery via Resend (https://resend.com). If these are not set, the
# website is honest about it: the form returns a clear "not connected yet"
# message with call / WhatsApp fallbacks, and no fake success is shown.
RESEND_API_KEY=
# Where inspection requests are delivered (the business inbox).
CONTACT_TO_EMAIL=
# The verified sending address for your Resend domain, e.g.
# "KINGA Pest Care <no-reply@your-domain.example>".
CONTACT_FROM_EMAIL=
